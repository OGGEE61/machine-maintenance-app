# Database (provided by the Neon integration on Vercel)
POSTGRES_URL=

# Admin login. Use a long value: attempts are limited, but short PINs are still guessable
ADMIN_PIN=

# Production address printed on QR stickers, without a trailing slash
NEXT_PUBLIC_APP_URL=

# Optional: order emails through Resend. Sending stays off until the first two are set
RESEND_API_KEY=
ORDER_FROM_EMAIL=
ORDER_NOTIFY_EMAIL=
